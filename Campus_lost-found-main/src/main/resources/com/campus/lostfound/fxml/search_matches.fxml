<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.campus.lostfound.controller.MatchController">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4" BorderPane.alignment="CENTER">
            <Label text="CAMPUS" styleClass="sidebar-brand"/>
            <Label text="LOST &amp; FOUND" styleClass="sidebar-brand"/>
            <Label text="SEARCH &amp; MATCHES" styleClass="sidebar-tag"/>
            <Region minHeight="20"/>

            <Button text="🏠  Dashboard" styleClass="nav-button" onAction="#handleGoToDashboard"/>
            <Button text="📝  Report an Item" styleClass="nav-button" onAction="#handleGoToReport"/>
            <Button text="🔍  Search &amp; Matches" styleClass="nav-button" onAction="#handleGoToSearch"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⎋  Log Out" styleClass="nav-button" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" style="-fx-padding: 28;">
            <Label text="Search &amp; Matches" styleClass="page-title"/>

            <TabPane tabClosingPolicy="UNAVAILABLE">
                <Tab text="Browse All Items">
                    <VBox spacing="14" style="-fx-padding: 16 0 0 0;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ComboBox fx:id="filterTypeCombo" promptText="Type"/>
                            <ComboBox fx:id="filterCategoryCombo" promptText="Category"/>
                            <ComboBox fx:id="filterLocationCombo" promptText="Location"/>
                            <TextField fx:id="keywordField" promptText="Search description..." HBox.hgrow="ALWAYS"/>
                            <Button text="Search" styleClass="button-primary" onAction="#handleSearch"/>
                        </HBox>

                        <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS" styleClass="card">
                            <columns>
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="70"/>
                                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120"/>
                                <TableColumn fx:id="locationColumn" text="Location" prefWidth="150"/>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="220"/>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="My Matches">
                    <VBox spacing="14" style="-fx-padding: 16 0 0 0;">
                        <TableView fx:id="matchesTable" VBox.vgrow="ALWAYS" styleClass="card">
                            <columns>
                                <TableColumn fx:id="matchLostColumn" text="Lost Item" prefWidth="220"/>
                                <TableColumn fx:id="matchFoundColumn" text="Found Item" prefWidth="220"/>
                                <TableColumn fx:id="matchScoreColumn" text="Confidence" prefWidth="100"/>
                                <TableColumn fx:id="matchStatusColumn" text="Status" prefWidth="110"/>
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="Confirm Selected Match" styleClass="button-primary" onAction="#handleConfirmMatch"/>
                            <Label fx:id="claimResultLabel" wrapText="true"/>
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
